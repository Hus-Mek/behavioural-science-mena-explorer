"""Local review-fix loop helper: read the pr-gate review on a PR and check a fix is not silencing.

    python tools/review_loop.py status <owner/repo> <pr> [--timeout 1200]
    python tools/review_loop.py verify-fix <before-sha> <after-sha>
    git log --format=%s A..B | python tools/review_loop.py rounds   # prints rounds=<n>, max=<cap>

The pr-gate `fix` job runs the installed copy (.github/pr-gate/review_loop) for `rounds` and
`verify-fix`, so the cap and the commit prefix are defined only here.

The agent fixes blocking findings for at most MAX_FIX_ROUNDS rounds (commits prefixed
"fix(review): "), each with a regression test, then hands the PR to the owner.
"""

import argparse
import json
import re
import subprocess
import sys
import time
from dataclasses import asdict, dataclass

MAX_FIX_ROUNDS = 3
FIX_PREFIX = "fix(review): "
GATE_CHECKS = frozenset({"attribution", "classify", "review", "fix", "push-fix"})
REQUIRED_CHECKS = frozenset({"attribution", "classify", "review"})
FINISHED = frozenset({"SUCCESS", "FAILURE", "SKIPPED", "NEUTRAL", "CANCELLED", "ERROR", "TIMED_OUT"})
BLOCKING_LABEL = "issue (blocking):"
# Only the gate's own comments count: anyone can comment, and finding text becomes fixer input.
REVIEW_BOT = "github-actions[bot]"
POLL_SECONDS = 20
TEST_PATH_RE = re.compile(r"(^|/)(tests?/|test_[^/]*$|[^/]*_test\.|[^/]*\.(test|spec)\.)")
DIFF_HEADER_RE = re.compile(r"^diff --git a/.* b/(.*)$")
ASSERT_RE = re.compile(r"\bassert|\bexpect\(")


@dataclass(frozen=True)
class Finding:
    path: str
    line: int | None
    body: str


def blocking_findings(comments: list[dict], head_sha: str) -> tuple[Finding, ...]:
    """Blocking inline findings first posted on the current head (GitHub moves commit_id forward; original_commit_id stays)."""
    return tuple(
        Finding(c["path"], c.get("line"), c["body"])
        for c in comments
        if c.get("original_commit_id") == head_sha
        and c.get("user", {}).get("login") == REVIEW_BOT
        and c.get("body", "").startswith(BLOCKING_LABEL)
    )


def gate_state(checks: list[dict]) -> str:
    names = [c.get("name", "").split(" / ")[-1] for c in checks]
    gates = [c for c, n in zip(checks, names) if n in GATE_CHECKS or n.startswith("review-pass")]
    if not gates:
        return "no-review"
    present = {c.get("name", "").split(" / ")[-1] for c in gates}
    finished = all(c.get("state") in FINISHED for c in gates)
    return "done" if finished and REQUIRED_CHECKS <= present else "pending"


def fix_rounds(commit_subjects: list[str]) -> int:
    return sum(s.startswith(FIX_PREFIX) for s in commit_subjects)


def round_outputs(commit_subjects: list[str]) -> dict[str, str]:
    """GitHub step outputs for the fix job: review-fix rounds already used, and the cap."""
    return {"rounds": str(fix_rounds(commit_subjects)), "max": str(MAX_FIX_ROUNDS)}


def silencing_signals(diff: str) -> tuple[str, ...]:
    """Reasons a review fix looks like it silences a finding instead of fixing it."""
    added_test = removed_asserts = 0
    path = ""
    for line in diff.splitlines():
        header = DIFF_HEADER_RE.match(line)
        if header:  # the per-file header names the file even when it is deleted (+++ /dev/null)
            path = header.group(1)
        elif TEST_PATH_RE.search(path) and not line.startswith(("+++", "---")):
            if line.startswith("+") and ASSERT_RE.search(line):
                added_test += 1
            elif line.startswith("-") and ASSERT_RE.search(line):
                removed_asserts += 1
    signals = []
    if not added_test:
        signals.append("no test added: every review fix needs a regression test")
    if removed_asserts:
        signals.append(f"removes {removed_asserts} assertion(s) from existing tests")
    return tuple(signals)


def gh_json(*args: str) -> list | dict:
    out = subprocess.run(["gh", *args], check=True, capture_output=True, text=True, encoding="utf-8").stdout
    return json.loads(out or "[]")


def parse_json_lines(raw: str) -> list[dict]:
    return [json.loads(line) for line in raw.splitlines() if line.strip()]


def pr_comments(repo: str, pr: str) -> list[dict]:
    """All review comments. --paginate prints one JSON array per page, so emit one object per line."""
    out = subprocess.run(["gh", "api", f"repos/{repo}/pulls/{pr}/comments", "--paginate", "--jq", ".[]"],
                         check=True, capture_output=True, text=True, encoding="utf-8").stdout
    return parse_json_lines(out)


def status(repo: str, pr: str, timeout: int) -> dict:
    deadline = time.monotonic() + timeout
    while True:
        view = gh_json("pr", "view", pr, "-R", repo, "--json", "headRefOid,commits,statusCheckRollup")
        checks = [{"name": c.get("name", ""), "state": c.get("conclusion") or c.get("status", "")}
                  for c in view["statusCheckRollup"]]
        state = gate_state(checks)
        if state != "pending" or time.monotonic() > deadline:
            break
        time.sleep(POLL_SECONDS)
    head = view["headRefOid"]
    rounds = fix_rounds([c["messageHeadline"] for c in view["commits"]])
    findings = blocking_findings(pr_comments(repo, pr), head)
    verdict = state if state != "done" else ("blocking" if findings else "clean")
    return {"status": verdict, "head": head, "fix_rounds": rounds, "rounds_left": max(MAX_FIX_ROUNDS - rounds, 0),
            "findings": [asdict(f) for f in findings]}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    st = sub.add_parser("status")
    st.add_argument("repo")
    st.add_argument("pr")
    st.add_argument("--timeout", type=int, default=1200)
    vf = sub.add_parser("verify-fix")
    vf.add_argument("before")
    vf.add_argument("after")
    sub.add_parser("rounds", help="read commit subjects on stdin; print rounds=<n> and max=<cap>")
    args = parser.parse_args()
    if args.command == "rounds":
        for key, value in round_outputs(sys.stdin.read().splitlines()).items():
            print(f"{key}={value}")
        return 0
    try:
        if args.command == "status":
            print(json.dumps(status(args.repo, args.pr, args.timeout), indent=2))
            return 0
        diff = subprocess.run(["git", "diff", f"{args.before}..{args.after}"], check=True,
                              capture_output=True, text=True, encoding="utf-8").stdout
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as err:
        print(f"review_loop: {getattr(err, 'stderr', '') or err}", file=sys.stderr)
        return 2
    signals = silencing_signals(diff)
    for s in signals:
        print(f"FAIL {s}")
    return 1 if signals else 0


if __name__ == "__main__":
    sys.exit(main())
